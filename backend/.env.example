# Example environment variables for the backend
# Copy to .env and fill real values before running in dev/production

DATABASE_URL=postgresql://jba_user:password@localhost:5432/jba_db
SECRET_KEY=change_me_to_a_secure_random_value
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Optional: settings for external APIs or email (leave blank until configured)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
